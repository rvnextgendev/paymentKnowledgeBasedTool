{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Payment RAG: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/rag-service/.venv/Scripts/python.exe",
            "module": "uvicorn",
            "args": ["app:app", "--port", "8000"],
            "cwd": "${workspaceFolder}/rag-service",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Payment RAG: Index knowledge",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/rag-service/.venv/Scripts/python.exe",
            "program": "${workspaceFolder}/rag-service/ingest.py",
            "cwd": "${workspaceFolder}/rag-service",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
